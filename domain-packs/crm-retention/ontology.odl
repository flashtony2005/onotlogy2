# 企业客户经营业务包：概念、生命周期和可执行动作。

object Company:
  properties:
    name: string
    code: string

object Department:
  properties:
    name: string
    code: string

object Employee:
  properties:
    name: string
    role: string

object Customer:
  properties:
    name: string
    level: string
    balance: float
    days_since_last_contact: int
  opportunities:
    Reactivation:
      subject_type: Customer
      estimated_value: 180000
      urgency_field: days_since_last_contact
      urgency_horizon: 90
      link_edge: targets
      goal_metric: monthly_reactivations
      evidence: "VIP 客户已 {days_since_last_contact} 天未联系，超过复购预警阈值"
      when:
        - field: self.level
          op: eq
          value: "VIP"
        - field: self.days_since_last_contact
          op: gt
          value: 45
  actions:
    ContactCustomer:
      planning:
        cost: 5000
        prior_confidence: 0.7
        outcome_timing: immediate
        goal_metric: monthly_reactivations
      updates:
        - field: days_since_last_contact
          value: 0
    RetainCustomer:
      planning:
        cost: 20000
        prior_confidence: 0.6
        outcome_timing: deferred
        goal_metric: monthly_reactivations
        benefit_field: balance
        benefit_factor: 0.35
      creates:
        - type: RetentionTask
          data:
            title: "客户挽留计划"
            customer: self
            status: "Pending"
            priority: "MEDIUM"
          link: needs_retention
          subject_field: customer
          decision_edge: produced_task
    refund:
      params:
        amount: float
      planning:
        cost: 100
        prior_confidence: 0.9
        outcome_timing: immediate
      updates:
        - field: balance
          value: amount
      policy:
        require_approval: true
        precondition:
          - field: amount
            op: le
            value: 1000
          - field: self.level
            op: ne
            value: "BLACKLIST"

object Contract:
  properties:
    title: string
    amount: float
    status: string

object Interaction:
  properties:
    channel: string
    summary: string
    occurred_at: string

object RiskSignal:
  properties:
    kind: string
    level: string
    status: string
    reason: string

object RetentionTask:
  properties:
    title: string
    customer: string
    status: string one_of [Pending,InProgress,Completed,Failed]
    priority: string
  actions:
    start:
      updates:
        - field: status
          value: "InProgress"
      policy:
        precondition:
          - field: self.status
            op: eq
            value: "Pending"
    complete:
      updates:
        - field: status
          value: "Completed"
      policy:
        precondition:
          - field: self.status
            op: eq
            value: "InProgress"
    fail:
      updates:
        - field: status
          value: "Failed"
      policy:
        precondition:
          - field: self.status
            op: eq
            value: "InProgress"

object Approval:
  properties:
    subject: string
    status: string
    amount: float

object BusinessGoal:
  properties:
    target_metric: string
    baseline_value: float
    target_value: float
    current_value: float
    status: string

object Opportunity:
  properties:
    subject: string
    opportunity_type: string
    status: string
    estimated_value: float
    evidence: string

object Decision:
  properties:
    opportunity: string
    action: string
    reason: string
    alternatives: string
    params: string
    decided_by: string
    status: string

object Outcome:
  properties:
    action: string
    before: string
    after: string
    success: bool
    cost: float
    metric: string
    stage: string one_of [ActionExecuted,BusinessResult]

object StateTransition:
  properties:
    subject: string
    before_data: string
    after_data: string
    at_action: string

relation has_goal:
  source: Company
  target: BusinessGoal

relation targets:
  source: Opportunity
  target: Customer

relation decided_from:
  source: Decision
  target: Opportunity

relation produced_outcome:
  source: Decision
  target: Outcome

relation produced_task:
  source: Decision
  target: RetentionTask

relation changed_state:
  source: StateTransition
  target: Customer

relation needs_retention:
  source: Customer
  target: RetentionTask
