#!/bin/sh
# pre-commit 质量门禁：fmt + clippy + 全量测试（与 make check 对齐）。
# 启用：git config core.hooksPath .githooks
set -e
cd "$(git rev-parse --show-toplevel)"

echo "── pre-commit: fmt ──"
cargo fmt --check || { echo "❌ fmt 未通过（运行 cargo fmt）"; exit 1; }

echo "── pre-commit: clippy ──"
cargo clippy --all-targets -- -D warnings || { echo "❌ clippy 未通过"; exit 1; }

echo "── pre-commit: test ──"
cargo test --all-targets || { echo "❌ 测试未通过"; exit 1; }

echo "✅ pre-commit 门禁通过"
