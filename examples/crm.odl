# OpenAIP-OS 示例本体（CRM）—— 演示 V0.4 完整 Action Engine
#
# 对象自有动作写在 `actions:` 块：动作由通用 ActionEngine 解释执行，
# 而非 Planner 硬编码。运行：oaip agent run --odl examples/crm.odl "reduce churn"

object Customer:
  properties:
    name: string
    level: string
    balance: float
  actions:
    # 挽留动作：为每个客户创建挽留任务并与之连边（替代 V0.3 硬编码 build_retention_plan）
    retain:
      creates:
        - type: RetentionTask
          data:
            title: "客户挽留计划"
            customer: self        # self → 目标客户 ID
          link: needs_retention   # 建立 Customer -needs_retention-> RetentionTask
    # 退款动作：需人工审批（Human Approval），且金额须 <= 1000、非黑名单客户
    refund:
      params:
        amount: float
      updates:
        - field: balance
          value: amount
      policy:
        require_approval: true
        precondition:
          - field: amount
            op: le
            value: 1000
          - field: self.level
            op: ne
            value: "BLACKLIST"

